# CryptoPilot Configuration Example (Copy to .env for local overrides)
# Never commit real API keys or secrets to version control.

CRYPTOPILOT_APP_NAME=CryptoPilot
CRYPTOPILOT_ENV=development
CRYPTOPILOT_DATABASE_URL=sqlite:///./data/cryptopilot.db

# Leave empty in dev to auto-generate an ephemeral/local instance key stored in backend/data/.secret.key
CRYPTOPILOT_SECRET_KEY=

# Frontend CORS origins (comma-separated)
CRYPTOPILOT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI Configuration (100% optional; CryptoPilot works fully without AI)
# Provider priority: auto | groq | ollama | disabled
CRYPTOPILOT_AI_PROVIDER=auto

# Free local Ollama
CRYPTOPILOT_OLLAMA_BASE_URL=http://localhost:11434
CRYPTOPILOT_OLLAMA_MODEL=llama3.2

# Optional Free-Tier Groq API Key (https://console.groq.com)
GROQ_API_KEY=
CRYPTOPILOT_GROQ_MODEL=llama-3.3-70b-versatile

# CryptoWatch remote advisory feeds (OSV & PyPI; falls back to curated local advisories when offline)
CRYPTOPILOT_ENABLE_REMOTE_ADVISORIES=true
